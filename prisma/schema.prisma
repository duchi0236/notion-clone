// ClawNote - Personal AI knowledge and document workspace
// PostgreSQL + Prisma schema for Notion/Yuque-like documents, tables, memories, inbox, calendar, and OpenClaw integration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String?  @unique  // 可空：纯手机/纯微信用户无邮箱
  phone       String?  @unique  // E.164，手机号登录归并键
  name        String?
  avatarUrl   String?
  password    String?           // 旧字段，迁移期与 AuthIdentity(PASSWORD) 双读
  tokenVersion Int     @default(0) // 改密/解绑后 +1，旧会话失效
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  documents       Document[]        @relation("DocumentCreator")
  comments        Comment[]
  memories        AgentMemory[]
  apiTokens       ApiToken[]
  calendarEvents  CalendarEvent[]   @relation("CalendarEventCreator")
  authIdentities  AuthIdentity[]
}

enum AuthProvider {
  PASSWORD
  PHONE
  WECHAT
}

// 统一身份：每种登录凭证一行，(provider, providerAccountId) 全局唯一
model AuthIdentity {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerAccountId String       // PASSWORD=email / PHONE=E.164 / WECHAT=unionid||openid
  secretHash        String?
  unionid           String?
  openid            String?
  isPrimary         Boolean      @default(false)
  createdAt         DateTime     @default(now())
  lastUsedAt        DateTime?

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([unionid])
}

model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String    @default("LOGIN")
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose])
}

model WechatTicket {
  id         String    @id @default(cuid())
  ticket     String    @unique
  state      String    @unique
  status     String    @default("PENDING")
  userId     String?
  unionid    String?
  openid     String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

// OIDC/OAuth2 一次性授权码（SSO：第三方应用 code 换 token）
model OAuthCode {
  id          String    @id @default(cuid())
  code        String    @unique
  clientId    String
  userId      String
  redirectUri String
  scope       String    @default("openid profile")
  nonce       String?
  codeChallenge String?
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([clientId])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  icon        String   @default("🧠")
  description String?
  ownerId     String
  owner       User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members      WorkspaceMember[]
  documents    Document[]
  collections  Collection[]
  objects      KnowledgeObject[]
  memories     AgentMemory[]
  inboxItems   InboxItem[]
  agentRuns    AgentRun[]
  templates    Template[]
  apiTokens    ApiToken[]
  calendars      Calendar[]
  calendarEvents CalendarEvent[]
  bitableBases   BitableBase[]
  aiConfig       AiConfig?
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

model Document {
  id             String         @id @default(cuid())
  title          String         @default("Untitled")
  icon           String?        @default("📄")
  coverImage     String?
  type           DocumentType   @default(DOC)
  status         DocumentStatus @default(DRAFT)
  parentId       String?
  sortIndex      Int            @default(0)

  contentJson    Json
  contentHtml    String         @db.Text
  contentText    String         @db.Text
  summary        String?        @db.Text
  tags           String[]       @default([])

  isFavorite     Boolean        @default(false)
  isPublished    Boolean        @default(false)
  isArchived     Boolean        @default(false)
  agentReadable  Boolean        @default(true)
  agentWritable  Boolean        @default(false)

  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById    String
  createdBy      User           @relation("DocumentCreator", fields: [createdById], references: [id])

  parent         Document?      @relation("DocumentChildren", fields: [parentId], references: [id])
  children       Document[]     @relation("DocumentChildren")
  blocks         Block[]
  comments       Comment[]
  versions       DocumentVersion[]
  objects        KnowledgeObject[]
  collectionRows CollectionRow[]
  calendarEvents CalendarEvent[]
  searchIndex    SearchIndex?
  calendarEvents CalendarEvent[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([workspaceId, parentId])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, isArchived])
}

enum DocumentType {
  DOC
  NOTE
  PROJECT
  SOP
  SOURCE
  MEETING
  AGENT_LOG
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  REVIEW
  PUBLISHED
  ARCHIVED
}

model Block {
  id            String    @id @default(cuid())
  type          BlockType
  content       Json
  properties    Json?
  sortIndex     Int       @default(0)
  parentBlockId String?

  documentId    String
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parentBlock   Block?    @relation("BlockChildren", fields: [parentBlockId], references: [id])
  children      Block[]   @relation("BlockChildren")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([documentId, sortIndex])
}

enum BlockType {
  TEXT
  HEADING_1
  HEADING_2
  HEADING_3
  BULLETED_LIST
  NUMBERED_LIST
  TO_DO
  TOGGLE
  QUOTE
  DIVIDER
  CODE
  IMAGE
  VIDEO
  FILE
  BOOKMARK
  CALLOUT
  TABLE
  TABLE_ROW
  EMBED
  DATABASE
  AI_SUMMARY
  AI_MEMORY
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  icon        String   @default("📊")
  description String?
  schema      Json
  views       Json
  // 轻量自动化规则（触发器+动作，客户端执行）：[{id,name,enabled,trigger,action}]
  automations Json     @default("[]")
  type        CollectionType @default(TABLE)
  sortIndex   Int       @default(0)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // When set, this collection is a data table inside a Bitable base.
  baseId      String?
  base        BitableBase? @relation(fields: [baseId], references: [id], onDelete: Cascade)

  rows        CollectionRow[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([baseId])
}

// A Bitable "base" (多维表格) groups several data tables (Collections).
model BitableBase {
  id          String   @id @default(cuid())
  name        String
  icon        String   @default("🗂️")
  description String?
  sortIndex   Int      @default(0)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  tables      Collection[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

enum CollectionType {
  TABLE
  BOARD
  GALLERY
  CALENDAR
  TASKS
}

model CollectionRow {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  documentId   String?
  document     Document?  @relation(fields: [documentId], references: [id])
  data         Json
  sortIndex    Int        @default(0)
  // 创建人/修改人：写入时落显示名快照（展示足够，避免跨表 join）
  createdBy    String?
  updatedBy    String?
  comments     RowComment[]
  revisions    RowRevision[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([collectionId, sortIndex])
}

// 多维表格记录评论
model RowComment {
  id        String        @id @default(cuid())
  rowId     String
  row       CollectionRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  author    String
  body      String
  createdAt DateTime      @default(now())

  @@index([rowId, createdAt])
}

// 多维表格记录修改历史：每次 PATCH data 时记录变更字段快照
model RowRevision {
  id        String        @id @default(cuid())
  rowId     String
  row       CollectionRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  author    String?
  // { fieldId: { from, to } }
  diff      Json
  createdAt DateTime      @default(now())

  @@index([rowId, createdAt])
}

model KnowledgeObject {
  id          String   @id @default(cuid())
  type        String
  title       String
  properties  Json
  relations   Json?
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, type])
}

model AgentMemory {
  id          String       @id @default(cuid())
  scope       MemoryScope  @default(WORKSPACE)
  content     String       @db.Text
  summary     String?
  tags        String[]     @default([])
  sourceType  String?
  sourceId    String?
  confidence  Float        @default(1)
  status      MemoryStatus @default(PENDING)

  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id])

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workspaceId, status])
}

enum MemoryScope {
  USER
  WORKSPACE
  PROJECT
  AGENT
}

enum MemoryStatus {
  PENDING
  ACCEPTED
  REJECTED
  ARCHIVED
}

model InboxItem {
  id          String      @id @default(cuid())
  source      InboxSource
  title       String
  content     String      @db.Text
  raw         Json?
  status      InboxStatus @default(UNPROCESSED)
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([workspaceId, status])
}

enum InboxSource {
  MANUAL
  OPENCLAW
  WEB_CLIP
  GITHUB
  FILE
  CHAT
}

enum InboxStatus {
  UNPROCESSED
  CONVERTED
  ARCHIVED
}

model AgentRun {
  id          String   @id @default(cuid())
  agentName   String
  input       Json
  output      Json?
  status      String
  documentIds String[] @default([])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, createdAt])
}

model Comment {
  id         String   @id @default(cuid())
  content    String   @db.Text
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  parentId   String?
  parent     Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[] @relation("CommentReplies")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([documentId])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version     Int
  changedBy   String
  snapshot    Json
  diff        Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

model Template {
  id          String   @id @default(cuid())
  title       String
  icon        String   @default("📄")
  description String?
  category    String
  contentJson Json
  contentHtml String   @db.Text
  tags        String[] @default([])
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SearchIndex {
  id          String   @id @default(cuid())
  documentId  String   @unique
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title       String
  text        String   @db.Text
  summary     String?  @db.Text
  tags        String[] @default([])
  embedding   Json?
  updatedAt   DateTime @updatedAt
}

model ApiToken {
  id          String   @id @default(cuid())
  name        String
  tokenHash   String   @unique
  scopes      String[] @default([])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
}

// One AI configuration per workspace: model provider settings + enabled skills.
model AiConfig {
  id            String   @id @default(cuid())
  workspaceId   String   @unique
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  provider      String   @default("none") // none | claude | openai | custom
  model         String   @default("")
  apiKey        String   @default("")
  baseUrl       String   @default("")
  temperature   Float    @default(0.7)
  maxTokens     Int      @default(2048)
  enabledSkills String[] @default(["search", "create", "summarize"])
  // 按能力存的供应商配置：{ image|video|edit: { provider, model, apiKey, baseUrl } }
  mediaProviders Json    @default("{}")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Calendar (Apple Calendar-style events)
// ---------------------------------------------------------------------------

model Calendar {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("blue")
  isDefault   Boolean  @default(false)
  sortIndex   Int      @default(0)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  events      CalendarEvent[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

model CalendarEvent {
  id          String              @id @default(cuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean             @default(false)
  color       String              @default("blue")
  status      CalendarEventStatus @default(CONFIRMED)
  source      CalendarEventSource @default(MANUAL)
  sourceId    String?
  metadata    Json?

  // Recurrence (preset rules expanded on the client)
  repeat          String?   // none | daily | weekly | biweekly | monthly | yearly
  repeatUntil     DateTime?
  // Reminder: minutes before start to notify (null = no reminder)
  reminderMinutes Int?

  calendarId  String?
  calendar    Calendar?  @relation(fields: [calendarId], references: [id], onDelete: SetNull)

  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  documentId  String?
  document    Document?  @relation(fields: [documentId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?      @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workspaceId, startsAt])
  @@index([workspaceId, source])
  @@index([calendarId])
}

enum CalendarEventStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
  DONE
}

enum CalendarEventSource {
  MANUAL
  TASK
  DOCUMENT
  IMPORTED
  AI
}
