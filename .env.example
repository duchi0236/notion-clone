# ClawNote Database
DATABASE_URL="postgresql://clawnote:clawnote@localhost:5432/clawnote?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Optional OAuth
# GITHUB_ID=""
# GITHUB_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# OpenClaw Gateway (the browser never receives these values)
OPENCLAW_GATEWAY_URL="http://127.0.0.1:18789"
OPENCLAW_GATEWAY_TOKEN="replace-with-a-long-random-gateway-token"
OPENCLAW_AGENT_ID="main"
OPENCLAW_REQUEST_TIMEOUT_MS="180000"

# Create a fine-grained Agent Token from ClawNote settings, then give it only to
# the OpenClaw plugin process. Do not use a broad shared development token.
CLAWNOTE_OPENCLAW_TOKEN=""
CLAWNOTE_BASE_URL="http://127.0.0.1:3000"

# Worker / Redis
REDIS_URL="redis://127.0.0.1:6379"
AGENT_WORKER_POLL_MS="1500"

# File storage
STORAGE_DRIVER="local"
UPLOAD_DIR="public/uploads"
