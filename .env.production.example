NODE_ENV=production
# 业务环境标记（移动端/灰度用）
APP_ENV=production

DATABASE_URL=postgresql://claw:change-me-password@postgres:5432/clawnote
# 对外公开的登录服务地址；OIDC 发现文档端点 URL 由它生成，必须是公网最终地址
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# OpenClaw Gateway：Token 只在 ClawNote 服务端与 Gateway 之间流转。
OPENCLAW_GATEWAY_URL=http://openclaw-gateway:18789
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-gateway-token
OPENCLAW_AGENT_ID=main
OPENCLAW_REQUEST_TIMEOUT_MS=180000

# 在 ClawNote 设置中创建细粒度 Agent Token；不得使用 legacy 宽权限 Token。
# 此值只注入 openclaw-gateway，不能进入浏览器或公开日志。
CLAWNOTE_BASE_URL=http://app:3000
CLAWNOTE_AGENT_TOKEN=replace-with-a-scoped-agent-token
AGENT_WORKER_POLL_MS=1500

# ---- SSO / OIDC 第三方客户端注册（JSON 字符串；不配则生产无任何客户端）----
# 详见 docs/CONFIG.md §C
# OIDC_CLIENTS=[{"clientId":"your-app","clientSecret":"...","redirectUris":["https://app.example.com/auth/callback"],"name":"Your App"}]
OIDC_CLIENTS=

# ---- 前端公开变量（实时协作 / drawio 画图）----
# 开启实时协作: NEXT_PUBLIC_COLLAB=1, NEXT_PUBLIC_COLLAB_WS=wss://your-domain.com/collab
NEXT_PUBLIC_COLLAB=
NEXT_PUBLIC_COLLAB_WS=
NEXT_PUBLIC_DRAWIO_URL=

# ---- 实时协作服务器（scripts/collab-server.cjs）----
# 票据签名密钥，缺省复用 NEXTAUTH_SECRET；生产必须配置其一
COLLAB_TOKEN_SECRET=
# 协作文档持久化目录（容器内路径，见 docker-compose.prod.yml）
COLLAB_PERSISTENCE_DIR=/app/collab-data

# 生产多人部署必须留空或删除本行；设为 1 时允许匿名共享 demo 工作区（单机自用）
CLAWNOTE_LOCAL_MODE=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

MAX_UPLOAD_MB=50
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,image/webp,image/gif,application/pdf,text/plain,text/markdown
UPLOAD_DIR=public/uploads

REDIS_URL=redis://redis:6379

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- 登录核心 auth-core（手机验证码 / 微信 / JWKS）----
# 用 `openssl rand -base64 32` 生成；占位/弱值在生产会被 env 校验拦截
OTP_SECRET=replace-with-a-long-random-secret
# JWKS 用 RS256 密钥对（缺省临时生成，仅 dev；生产务必固定）：
#   openssl genpkey -algorithm RSA -out priv.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in priv.pem -pubout -out pub.pem
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=

# 短信（手机验证码，阿里云/腾讯云二选一）
SMS_PROVIDER=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_SDK_APP_ID=

# 微信开放平台（网站应用扫码登录）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://your-domain.com/api/auth/wechat/callback

# 人机验证（OTP 前置防刷）
CAPTCHA_PROVIDER=
TURNSTILE_SECRET=

# 媒体生成（文生图/视频供应商，可被控制台配置覆盖）
MEDIA_PROVIDER=
MEDIA_API_KEY=
