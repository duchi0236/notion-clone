{
  "name": "clawnote",
  "version": "1.0.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run collab\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k -n next,electron -c blue,magenta \"next dev -p 3001\" \"wait-on http://localhost:3001 && electron .\"",
    "desktop:dist": "electron-builder",
    "desktop:dist:dir": "electron-builder --dir",
    "mobile": "npm --prefix mobile run start",
    "mobile:dev": "concurrently -k -n next,expo -c blue,magenta \"next dev -p 3001\" \"npm --prefix mobile run start\"",
    "mobile:tunnel": "concurrently -k -n next,expo -c blue,magenta \"next dev -p 3001\" \"npm --prefix mobile run start -- --tunnel\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:vector": "tsx prisma/setup-vector.ts",
    "db:studio": "prisma studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "collab": "node scripts/collab-server.cjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "build": {
    "appId": "ai.clawnote.app",
    "productName": "ClawNote",
    "copyright": "ClawNote",
    "afterSign": "build/notarize.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "tray*.png",
          "icon.png"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://dl.clawnote.app/${os}"
      }
    ]
  },
  "dependencies": {
    "@hello-pangea/dnd": "^16.6.0",
    "@prisma/client": "^5.17.0",
    "@tiptap/extension-code-block-lowlight": "^2.4.0",
    "@tiptap/extension-collaboration": "^2.4.0",
    "@tiptap/extension-collaboration-cursor": "^2.4.0",
    "@tiptap/extension-highlight": "^2.4.0",
    "@tiptap/extension-image": "^2.4.0",
    "@tiptap/extension-link": "^2.4.0",
    "@tiptap/extension-placeholder": "^2.4.0",
    "@tiptap/extension-table": "^2.4.0",
    "@tiptap/extension-table-cell": "^2.4.0",
    "@tiptap/extension-table-header": "^2.4.0",
    "@tiptap/extension-table-row": "^2.4.0",
    "@tiptap/extension-task-item": "^2.4.0",
    "@tiptap/extension-task-list": "^2.4.0",
    "@tiptap/extension-text-align": "^2.4.0",
    "@tiptap/extension-underline": "^2.4.0",
    "@tiptap/pm": "^2.4.0",
    "@tiptap/react": "^2.4.0",
    "@tiptap/starter-kit": "^2.4.0",
    "bcryptjs": "^2.4.3",
    "katex": "^0.16.11",
    "mermaid": "^11.4.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "electron-updater": "^6.3.9",
    "ioredis": "^5.4.1",
    "jose": "^5.10.0",
    "lowlight": "^3.1.0",
    "lucide-react": "^0.412.0",
    "nanoid": "^5.0.7",
    "next": "14.2.5",
    "next-auth": "^4.24.7",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0",
    "xlsx": "^0.18.5",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.18",
    "zustand": "^4.5.4"
  },
  "optionalDependencies": {
    "y-leveldb": "^1.0.9"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.0",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.39",
    "prisma": "^5.17.0",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "wait-on": "^8.0.1"
  }
}
